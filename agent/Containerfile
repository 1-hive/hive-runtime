# 1-hive agent image: one container per agent attempt (PLAN Phase E 1, SPEC §6.6).
# Built by build.sh, which copies the host's current claude, codex (if any) and uv binaries in; the
# record's CLI at HIVERECORD_REV (build.sh passes HIVE_RECORD_TOOL_REF).
#
# The agent runs as root inside its rootless container: container root is the host user,
# so files it writes in its mounted task folder belong to the host user, and nested
# podman (games, seats) gets the container's other 65535 ids.
FROM docker.io/library/ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl git jq less openssh-client procps python3 python3-venv file unzip xz-utils \
      podman fuse-overlayfs uidmap slirp4netns passt catatonit iptables iproute2 netavark aardvark-dns socat tmux \
    && rm -rf /var/lib/apt/lists/* \
    && echo "root:1:65535" > /etc/subuid && echo "root:1:65535" > /etc/subgid
COPY bin/ /usr/local/bin/
COPY codex/ /opt/codex/
RUN if [ -x /opt/codex/bin/codex ]; then ln -s /opt/codex/bin/codex /usr/local/bin/codex && codex --version; fi
ENV HOME=/root PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ARG HIVERECORD_REV=v1.1.0
RUN uv tool install --with-executables-from hivepin "hiverecord @ git+https://github.com/1-hive/hive-record@${HIVERECORD_REV}" \
    && hive --help >/dev/null && hive-pin --help >/dev/null
# The chief of staff's MCP server over the record (hive-mcp.py).
COPY hive-mcp.py /opt/hive-mcp/hive-mcp.py
RUN uv venv -q /opt/hive-mcp/venv && uv pip install -q --python /opt/hive-mcp/venv/bin/python "mcp>=2,<3" \
    && /opt/hive-mcp/venv/bin/python -c "from mcp.server.mcpserver import MCPServer"
COPY containers.conf /etc/containers/containers.conf
COPY hive-entry /usr/local/bin/hive-entry
ENTRYPOINT ["/usr/local/bin/hive-entry"]
WORKDIR /root
